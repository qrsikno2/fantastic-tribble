{
  "name": "fantastic-tribble",
  "version": "0.1.0",
  "description": "Read-only MCP server for the BYR forum",
  "type": "module",
  "bin": {
    "fantastic-tribble": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/clean-dist.mjs && tsc",
    "prepack": "npm run build",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.5"
  }
}
